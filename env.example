# Never commit real credentials.
API_ID=
API_HASH=
BOT_TOKEN=

# Atlas connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=

ADMIN_IDS=8094431666,8405171028

MAIN_CHANNEL_ID=@Learn_X_Edu
MAIN_CHANNEL_URL=https://t.me/Learn_X_Edu

PUBLIC_GROUP_ID=@Learn_X_discussion_grp
PUBLIC_GROUP_URL=https://t.me/Learn_X_discussion_grp

PRIVATE_GROUP_ID=-1004420311820
LOG_GROUP_ID=-1004284055578

DATA_DIR=/tmp
# ":memory:" fits Heroku (no persistent disk). A file name only for local dev.
SESSION_NAME=:memory:
PROTECT_CONTENT=false
LOG_LEVEL=INFO

# Optional seed tutor groups (JSON list). Can also be managed at runtime
# with /addtutor, /rmtutor and /tutors. KEY doubles as the folder name
# that auto-guards that tutor's files.
# TUTOR_GROUPS=[{"key":"ap","display_name":"Anuradha Perera","group_id":"@ap_papers","invite_url":"https://t.me/ap_papers"}]
TUTOR_GROUPS=

# Public HTTPS URL of this deployment (for the Telegram Mini App).
# Example: https://your-app-name.herokuapp.com
# The mini app is served at APP_URL/miniapp and the button appears in /start and /app.
APP_URL=

# Port for the mini app web server. Heroku injects PORT automatically;
# only set this for local development (defaults to 8080).
# PORT=8080

# Password for the web admin panel. Open /panel?key=YOUR_PASSWORD in a browser.
# Empty = panel disabled (recommended to keep it empty locally).
PANEL_PASSWORD=

# Discussion materials per tutor key. A bare number is a message ID forwarded
# from the main channel; t.me URLs are sent as links. Used by /discussion and
# the Discussions buttons in the mini app.
# Example: {"ap":"1234, 1235","sd":"https://t.me/Learn_X_Edu/789"}
DISCUSSIONS=
